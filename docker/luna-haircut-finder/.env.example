# Copy to .env and fill in the two secrets. Only .env is gitignored.

# --- Required ---
LUNA_BOT_TOKEN=${LUNA_BOT_TOKEN}
LUNA_CHAT_ID=${LUNA_CHAT_ID}

# --- Optional (defaults shown) ---
# Seconds between polls
LUNA_POLL_INTERVAL=3600
# Salon identifiers from the booking API
LUNA_BUSINESS_ID=${LUNA_BUSINESS_ID}
# Comma-separated service ids
LUNA_SERVICE_IDS=${LUNA_SERVICE_IDS}
# Only consider slots on or before this date (YYYY-MM-DD, salon-local). Leave unset for all.
# LUNA_THRESHOLD_DATE=2026-09-30
# How many earliest slots to list in each alert
LUNA_SPOTS_TO_SHOW=3
